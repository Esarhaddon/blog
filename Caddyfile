:3000 {
	# Serve static assets
	route * {
		# Handle paths like /app.ff282437ea9a6dafd8286c6f04bc2d8c25bf3e27.js by
		# removing the fingerprint if an exact match isn't found
		@fingerprinted {
			path_regexp ^([^.]+)\.[^/.]+\.([^/.]+)$
		}
		handle @fingerprinted {
			header Cache-Control "max-age=31536000, immutable"

			try_files {path} {re.1}.{re.2}

			file_server
		}

		# Cache font files forever. If they change they should be called something
		# different
		@font {
			path_regexp .woff2$
		}
		handle @font {
			header Cache-Control "max-age=31536000, immutable"
		}

		try_files {path}

		file_server
	}

	# Respond with html if "pages" + {path} corresponds to a path in the pages
	# folder, including an importmap to fingerprint files for caching and
	# "modulepreload" link tags to flatten the waterfall
	@page {
		file pages{path}.js pages{path}index.js pages{path}/index.js
	}
	handle @page {
		header Content-Type text/html

		try_files pages{path}.js pages{path}index.js pages{path}/index.js

		templates

		respond `
      {{- define "parsefile" -}}
        {{- $visited := .VisitedPaths -}}
        {{- $path:= .Path -}}
        {{- $file:= readFile .Path -}}

        {{- $_ := set $visited $path (sha1sum $file) -}}

        {{- $imports := regexFindAll "(import|export) ([^()/;\"]* from )?(\".*?\\.js\";?)" $file -1 -}}
        {{- range $imports -}}
          {{- $importPath:= clean (print (dir $path) "/" (regexReplaceAll "\"" (regexFind "\".*?\"" .) "")) -}}
          {{- if not (hasKey $visited $importPath) -}}
            {{- template "parsefile" dict "Path" $importPath "VisitedPaths" $visited -}}
          {{- end -}}
        {{- end }}
      {{- end -}}

      {{- $visitedPaths := dict -}}
      {{- template "parsefile" dict "Path" (ph "http.request.uri.path") "VisitedPaths" $visitedPaths -}}
      {{- $keys := (keys $visitedPaths) | sortAlpha -}}
      {{- $backtick := printf "%c" 96 -}}

<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="importmap">
      {
        "imports": {
          {{- range listFiles "/vendor" }}
          "{{ trimSuffix ".js" . }}": "/vendor/{{ trimSuffix ".js" . }}.{{ sha1sum (readFile (print "/vendor/" .)) }}.js",
          {{- end }}
          {{- range $index, $key := $keys }}
          "/{{ . }}": "/{{trimSuffix ".js" $key}}.{{ get $visitedPaths $key }}.js"{{ if ne $index (sub (len $keys) 1) }},{{ end }}
          {{- end }}
        }
      }
    </script>
    <link rel="stylesheet" href="/global.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.12.0/build/styles/default.min.css"
    />
    <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.12.0/build/highlight.min.js"></script>
    {{- range listFiles "/vendor" }}
    <link rel="modulepreload" href="/vendor/{{ trimSuffix ".js" . }}.{{ sha1sum (readFile (print "/vendor/" .)) }}.js" />
    {{- end }}
    {{- range $keys }}
    <link rel="modulepreload" href="/{{ trimSuffix ".js" . }}.{{ get $visitedPaths . }}.js" />
    {{- end }}
  <script type="module">
    import { createRoot, html } from "aspen"
    import * as app from "/{{ ph "http.request.uri.path" }}"
    
    const root = createRoot(document.getElementById("root"), app)
    root.render(html{{ $backtick }}<Page />{{ $backtick }})
  </script>
  </head>
  <body>
    <div id="root">loading...</div>
  </body>
</html>`
	}
}
